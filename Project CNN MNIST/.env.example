# Environment Configuration for MNIST CNN Project
# Copy this file to .env and customize values

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Data Configuration
DATA_DIR=data/processed
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Model Configuration
MODEL_NAME=mnist_cnn
NUM_CLASSES=10
HIDDEN_FEATURES=128
MODEL_CHECKPOINT_DIR=artifacts/checkpoints
MODEL_EXPORT_DIR=artifacts/models

# Training Configuration
BATCH_SIZE=64
NUM_EPOCHS=20
LEARNING_RATE=0.001
WEIGHT_DECAY=0.0
OPTIMIZER=adam
DEVICE=cuda

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
CUDA_LAUNCH_BLOCKING=1

# Logging Configuration
LOG_DIR=artifacts/logs
LOG_LEVEL=INFO
TENSORBOARD_DIR=artifacts/logs/tensorboard

# Experiment Configuration
EXPERIMENT_NAME=baseline
EXPERIMENT_CONFIG=configs/experiments/baseline.yaml

# Docker Configuration
DOCKER_IMAGE=mnist-cnn:latest
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_DEBUG=false

# Jupyter Configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=
JUPYTER_ENABLE_LAB=true

# Database Configuration (if using)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mnist
DB_PASSWORD=mnist123
DB_NAME=mnist_db

# Deployment Configuration
DEPLOYMENT_ENV=development
DEPLOYMENT_REGION=local
DEPLOYMENT_VERSION=2.0.0

# Feature Flags
ENABLE_TENSORBOARD=true
ENABLE_PROFILING=false
ENABLE_VALIDATION=true
ENABLE_EXPORT=true

# Performance Configuration
NUM_WORKERS=4
PIN_MEMORY=true
MIXED_PRECISION=false

# Security Configuration
ENABLE_HTTPS=false
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
SECRET_KEY=your-secret-key-here

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
